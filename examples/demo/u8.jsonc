// Demo workspace exercising every u8cli concept end to end.
// Run from this directory:  u8            (dashboard)
//                           u8 start      (start the active profile)
//                           u8 run test   (task command across targets)
//                           u8 -i try up  (a second copy, on its own ports)
{
  "$schema": "../../schema.json",
  "name": "u8-demo",

  // Applied to every spawned process, then overridden per repo / per app.
  "env": {
    "NODE_ENV": "development"
  },

  // Where instances other than base get their ports from. Base keeps the
  // numbers written under each app's "ports".
  "instances": {
    "ports": { "from": 3200, "to": 3299 }
  },

  "templates": {
    "repo": "{repo@name:pad(20)} {repo@dirname:dim} {git@branch:color(yellow):max(18)} {git@dirty:color(red)}",
    // Status and health are padded because without colour they render as words
    // ("running"/"starting") rather than a fixed-width glyph.
    "app": "  {app@status} {app@name:max(16):pad(16)} {health@status:pad(9)} {app@uptime:dim:pad(5)} {port:dim}"
  },

  // {port} — a config-defined indicator: shell command polled per target.
  "indicators": {
    "port": {
      "cmd": "node -e \"process.stdout.write(process.env.PORT||'-')\"",
      "interval": 30000
    }
  },

  "repos": {
    // Non-HTTP dependency, probed with a shell healthcheck, auto-restarted.
    "db": {
      "path": "./services/infra",
      // ${instance.suffix} is empty in base and "_<name>" elsewhere, so every
      // instance that runs its own db gets its own ready-file.
      "env": { "DB_READY_FILE": "/tmp/u8-demo-db${instance.suffix}.ready" },
      "scripts": {
        "start": "node fake-db.js"
      },
      // A shell probe reads what it needs from the app's env.
      "health": {
        "cmd": "test -f \"$DB_READY_FILE\"",
        "interval": 2000
      },
      "restart": "on-crash"
    },

    // Single-service repo: no apps, so it becomes one implicit app.
    "api": {
      "path": "./services/api",
      // The port is declared once and referenced everywhere else.
      "ports": { "http": 3000 },
      "env": { "PORT": "${ports.http}", "SERVICE_NAME": "api" },
      "scripts": {
        "start": "node server.js",
        "test": "node -e \"console.log('api tests ok')\""
      },
      "health": { "http": "http://localhost:${ports.http}/healthz" },
      "dependsOn": ["db"],
      // What a fresh checkout of this repo needs, and what to undo afterwards.
      "instance": {
        "init": ["echo \"preparing $U8_REPO for instance $U8_INSTANCE\""],
        "teardown": ["echo \"cleaning up after $U8_INSTANCE\""]
      }
    },

    // Monorepo: FE shell plus a micro-frontend, each its own process.
    "platform": {
      "path": "./services/platform",
      "env": { "TZ": "UTC" },
      "apps": {
        "shell": {
          "path": "apps/shell",
          "ports": { "http": 3100 },
          "env": { "PORT": "${ports.http}" },
          "scripts": { "start": "node server.js" },
          "health": { "http": "http://localhost:${ports.http}/healthz" }
        },
        "auth-mfe": {
          "path": "apps/auth-mfe",
          "ports": { "http": 3101 },
          // Another app's port: the instance's own api when it has one,
          // base's otherwise.
          "env": { "PORT": "${ports.http}", "API_URL": "http://localhost:${api.ports.http}" },
          "scripts": { "start": "node server.js" },
          "health": { "http": "http://localhost:${ports.http}/healthz" },
          "dependsOn": ["api"]
        }
      }
    }
  },

  "profiles": {
    "full": {
      "default": true,
      "targets": ["db", "api", "platform"]
    },
    "frontend": {
      "targets": ["platform.shell", "platform.auth-mfe"]
    }
  },

  "commands": {
    // Shared script with a per-target override and an explicit skip.
    "test": {
      "description": "Run each service's test suite",
      "script": "echo \"no tests for $PWD\"",
      "targets": {
        "api": "node -e \"console.log('api tests ok')\"",
        "db": null
      }
    },

    // Hooks gate the command per target: refuse to deploy from a dirty tree.
    "deploy": {
      "description": "Pretend to deploy",
      "targets": {
        "api": "echo deploying api",
        "platform.shell": "echo deploying shell"
      },
      "hooks": {
        "pre": "git diff --quiet || (echo 'refusing: working tree is dirty' && exit 1)",
        "post": "echo deploy finished"
      }
    }
  },

  // Hooks for a command that has no entry above: a core one, by name. A post
  // hook reads how it went from its environment.
  "hooks": {
    "app:stop": { "post": "echo \"$U8_TARGET stopped: $U8_STATUS\"" }
  }
}
